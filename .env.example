# Web
NEXT_PUBLIC_API_URL=http://localhost:8080

# API
PORT=8080
TCP_PORT=9090
UDP_PORT=9091
GRPC_PORT=9092
WEBSOCKET_PORT=9093
ALLOWED_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=admin@example.com
ADMIN_SYNC_TOKEN=replace-with-a-long-random-admin-sync-token
ANILIST_BOOTSTRAP_STATUSES=RELEASING,HIATUS
ANILIST_BOOTSTRAP_LIMIT=30
MANGADEX_BOOTSTRAP_STATUSES=ongoing,hiatus
MANGADEX_BOOTSTRAP_LIMIT=50

# Local fallback database. Used only when DATABASE_URL is empty.
DATABASE_PATH=mangahub.db

# Neon/Postgres. Include sslmode=require or the API will add it.
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# Chapter page storage. Use "r2" in production; local is for dev fallback.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
# Optional if R2_ACCOUNT_ID is set. Example: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=mangahub-chapter-pages
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_REGION=auto
# Public bucket URL or custom domain used in reader image src values.
R2_PUBLIC_BASE_URL=https://cdn.example.com

# Local fallback storage when STORAGE_PROVIDER=local.
CHAPTER_UPLOAD_DIR=data/uploads/chapters
